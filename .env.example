# Public testnet RPCs. Swap in a second URL if these 429.
# Spec URL rpc.sepolia.org is currently dead; PublicNode is the working default.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
SEPOLIA_RPC_URL_FALLBACK=https://1rpc.io/sepolia
UNICHAIN_SEPOLIA_RPC_URL_FALLBACK=https://unichain-sepolia.drpc.org
SETTLEMENT_CHAIN=sepolia
# Each Superchain L2 has its own L1StandardBridge on Ethereum Sepolia.
# Never Unichain/Base/OP mainnet bridges (0x81014F44… / 0x3154Cf16… / 0x99C9fc46…).
UNICHAIN_L1_BRIDGE_SEPOLIA=0xea58fcA6849d79EAd1f26608855c2D6407d54Ce2
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_URL_FALLBACK=https://base-sepolia-rpc.publicnode.com
BASE_L1_BRIDGE_SEPOLIA=0xfd0Bf71F60660E2f608ed56e1659C450eB113120
OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io
OP_SEPOLIA_RPC_URL_FALLBACK=https://optimism-sepolia-rpc.publicnode.com
OP_L1_BRIDGE_SEPOLIA=0xFBb0621E0B23b5478B630BD55a5f21f67730B0F1
INK_SEPOLIA_RPC_URL=https://rpc-gel-sepolia.inkonchain.com
INK_L1_BRIDGE_SEPOLIA=0x33f60714BbD74d62b66D79213C348614DE51901C
MODE_SEPOLIA_RPC_URL=https://sepolia.mode.network
MODE_L1_BRIDGE_SEPOLIA=0xbC5C679879B2965296756CD959C3C739769995E2
SONEIUM_MINATO_RPC_URL=https://rpc.minato.soneium.org
SONEIUM_L1_BRIDGE_SEPOLIA=0x5f5a404A5edabcDD80DB05E8e54A78c9EBF000C2

# Emergency second source if Unichain Sepolia itself (not just one RPC) goes down.
# Blank by default — never auto-started. Run scripts/emergency_anvil_source.sh first.
ANVIL_EMERGENCY_RPC_URL=
CLAIM_SOURCE_ANVIL_EMERGENCY=

# Fresh throwaway key. Never a mainnet key. Fund Sepolia ETH, then bridge to Unichain Sepolia.
# Private keys are deliberately left blank here — do not commit keys.
DEPLOYER_PRIVATE_KEY=
OPERATOR_ADDRESS=0x30C80ce55Ea8a8055DFa3B6D9Be303bD6b01F16a
ISSUER_A_PRIVATE_KEY=
ISSUER_B_PRIVATE_KEY=
DEMO_SUBJECT=0x5cCBd2Ef7DBC744AbFF179F5C5B8180B182B1221

# Live 2026-08-23 deploy. FR-01 pair is Sepolia + Unichain. Extra L2s filled after
# scripts/bridge_sepolia_to_l2.sh + scripts/deploy_extra_l2s.sh. Ask before redeploying.
CLAIM_SOURCE_SEPOLIA=0x16366eaeEddB90C990704ee6d12C43B30D9CF614
CLAIM_SOURCE_UNICHAIN_SEPOLIA=0x5c2749F63fC6f50C600DA04f0Fd87bF8299c2c59
CLAIM_SOURCE_BASE_SEPOLIA=0x5c2749F63fC6f50C600DA04f0Fd87bF8299c2c59
CLAIM_SOURCE_OP_SEPOLIA=0x5c2749F63fC6f50C600DA04f0Fd87bF8299c2c59
CLAIM_SOURCE_INK_SEPOLIA=0x5c2749F63fC6f50C600DA04f0Fd87bF8299c2c59
CLAIM_SOURCE_MODE_SEPOLIA=0x5c2749F63fC6f50C600DA04f0Fd87bF8299c2c59
CLAIM_SOURCE_SONEIUM_MINATO=0x5c2749F63fC6f50C600DA04f0Fd87bF8299c2c59
IDENTITY_STATE_SEPOLIA=0xE11CD3Bb815ED4CA95692907ABa6fB3180F84894

# Operator default for live ingest extract (P1). LiteLLM accepts any
# OpenAI-compatible base_url/model (Ollama, Groq OpenAI mode, Together, gateways).
# If LLM_API_KEY is empty, extract uses the rules parser and explain uses the SHAP
# template — FR-02 still passes. Frontend BYOK is browser localStorage + per-request
# only; it is never written here, to overlay, or to explanation JSON.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

MODEL_PATH=data/model.joblib
METRICS_PATH=data/metrics.json
OVERLAY_PATH=data/overlay.json
CURSORS_PATH=data/cursors.json
EXPLANATIONS_DIR=data/explanations

REPLAY_BEARER=
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins, or * (workstation demo). Set to the Vercel
# production host before exposing the API on a public URL. See DEVOPS.html.
CORS_ORIGINS=*

# Dashboard production build (Vite inlines this). Leave blank so the UI asks
# for an API base. Never put keys in VITE_* — they ship in the JS bundle.
# VITE_API_BASE=

# Optional extras
ETHERSCAN_API_KEY=
