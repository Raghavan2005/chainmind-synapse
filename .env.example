AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
SEPOLIA_RPC_URL_FALLBACK=https://1rpc.io/sepolia
AMOY_RPC_URL_FALLBACK=https://polygon-amoy.drpc.org
SETTLEMENT_CHAIN=sepolia

# Fresh throwaway key. Never a mainnet key. Fund Sepolia + Amoy faucets.
# Private keys are deliberately left blank here — get them from a teammate
