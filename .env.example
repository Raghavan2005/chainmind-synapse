# Public testnet RPCs. Swap in a second URL if these 429.
# Spec URL rpc.sepolia.org is currently dead; PublicNode is the working default.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
SEPOLIA_RPC_URL_FALLBACK=https://1rpc.io/sepolia
UNICHAIN_SEPOLIA_RPC_URL_FALLBACK=https://unichain-sepolia.drpc.org
SETTLEMENT_CHAIN=sepolia
# Unichain Sepolia L1StandardBridge on Ethereum Sepolia. Never the mainnet bridge.
UNICHAIN_L1_BRIDGE_SEPOLIA=0xea58fcA6849d79EAd1f26608855c2D6407d54Ce2

# Fresh throwaway key. Never a mainnet key. Fund Sepolia ETH, then bridge to Unichain Sepolia.
# Private keys are deliberately left blank here — do not commit keys.
DEPLOYER_PRIVATE_KEY=
OPERATOR_ADDRESS=0x30C80ce55Ea8a8055DFa3B6D9Be303bD6b01F16a
ISSUER_A_PRIVATE_KEY=
ISSUER_B_PRIVATE_KEY=
DEMO_SUBJECT=0x5cCBd2Ef7DBC744AbFF179F5C5B8180B182B1221

# Live 2026-08-23 deploy (Sepolia + Unichain Sepolia). Ask before redeploying.
CLAIM_SOURCE_SEPOLIA=0x16366eaeEddB90C990704ee6d12C43B30D9CF614
CLAIM_SOURCE_UNICHAIN_SEPOLIA=0x5c2749F63fC6f50C600DA04f0Fd87bF8299c2c59
